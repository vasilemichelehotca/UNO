gn=center;verticalAlign=middle;fontFamily=Arial;fontSize=17;strokeColor=#60778A;fillColor=#EFF3F7;" vertex="1" parent="1"><mxGeometry x="130" y="150" width="420" height="180" as="geometry" /></mxCell><mxCell id="drawn" value="DRAWN_CARD_AVAILABLE&lt;br&gt;&lt;br&gt;Play the drawn value or keep it and pass" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=17;strokeColor=#60778A;fillColor=#EFF3F7;" vertex="1" parent="1"><mxGeometry x="890" y="150" width="420" height="180" as="geometry" /></mxCell><mxCell id="four" value="AWAITING_WILD_DRAW_FOUR_RESPONSE&lt;br&gt;&lt;br&gt;Recipient accepts or challenges the +4" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=17;strokeColor=#60778A;fillColor=#EFF3F7;" vertex="1" parent="1"><mxGeometry x="890" y="580" width="420" height="180" as="geometry" /></mxCell><mxCell id="result" value="Round&lt;br&gt;&lt;br&gt;complete?" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=17;strokeColor=#60778A;fillColor=#EFF3F7;" vertex="1" parent="1"><mxGeometry x="410" y="650" width="150" height="150" as="geometry" /></mxCell><mxCell id="round" value="ROUND_OVER&lt;br&gt;&lt;br&gt;Points match below the victory target" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=17;strokeColor=#60778A;fillColor=#EFF3F7;" vertex="1" parent="1"><mxGeometry x="130" y="1090" width="420" height="150" as="geometry" /></mxCell><mxCell id="game" value="GAME_OVER&lt;br&gt;&lt;br&gt;Single round or points target reached" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=17;strokeColor=#60778A;fillColor=#EFF3F7;" vertex="1" parent="1"><mxGeometry x="890" y="1090" width="420" height="150" as="geometry" /></mxCell><mxCell id="final" value="" style="shape=doubleEllipse;fillColor=#203348;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=17;strokeColor=#60778A;fillColor=#EFF3F7;fillColor=#203348;" vertex="1" parent="1"><mxGeometry x="1350" y="1150" width="28" height="28" as="geometry" /></mxCell><mxCell id="note" value="The diamond is a decision pseudostate, not a GamePhase. UNO call-outs do not advance the main phase.&lt;br&gt;GAME_OVER ends this engine; New game creates a new engine. Penalties are resolved before scoring." style="text;html=1;fontSize=15;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#526575;" vertex="1" parent="1"><mxGeometry x="60" y="1300" width="1280" height="48" as="geometry" /></mxCell><mxCell id="title" value="UNO - turn state machine" style="text;html=1;fontSize=25;fontStyle=1;align=left;fontColor=#203348;" vertex="1" parent="1"><mxGeometry x="35" y="16" width="900" height="40" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>